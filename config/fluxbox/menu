# Xedra Linux - Minimal Fluxbox Root Menu
[begin] (Xedra Linux 0.1)
  [exec] (Terminal) {xterm -bg black -fg white -fa 'Monospace' -fs 11}
  [separator]
  [submenu] (System Tools)
    [exec] (Process Monitor) {xterm -e top}
    [exec] (Disk Space) {xterm -hold -e df -h}
    [exec] (Network Info) {xterm -hold -e ip addr}
  [end]
  [separator]
  [restart] (Restart Fluxbox)
  [exit] (Exit X11)
[end]
