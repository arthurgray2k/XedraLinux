#!/bin/sh
# ==============================================================================
# Xedra Linux - Default X11 Session Starter (.xinitrc)
# ==============================================================================

# 1. Load X resources if present
if [ -f "$HOME/.Xresources" ]; then
    xrdb -merge "$HOME/.Xresources"
fi

# 2. Set clean solid background color (prevents fbsetbg warning)
if command -v xsetroot >/dev/null 2>&1; then
    xsetroot -solid "#1e1e1e"
fi

# 3. Start SPICE agent for seamless mouse cursor & clipboard synchronization
if command -v spice-vdagent >/dev/null 2>&1; then
    spice-vdagent &
fi

# 4. Launch default terminal on desktop start
xterm -geometry 80x24+50+50 &

# 5. Launch Fluxbox window manager as master X11 process
exec fluxbox
