#!/bin/sh
# ==============================================================================
# Xedra Linux - Default X11 Session Starter (.xinitrc)
# ==============================================================================

# 1. Load X resources if present
if [ -f "$HOME/.Xresources" ]; then
    xrdb -merge "$HOME/.Xresources"
fi

# 2. Set comfortable default display resolution (1366x768 / 1280x800 ~30% larger than 1024x768)
if command -v xrandr >/dev/null 2>&1; then
    PRIMARY_DISP="$(xrandr | grep ' connected' | awk '{print $1}' | head -n 1)"
    if [ -n "$PRIMARY_DISP" ]; then
        xrandr --output "$PRIMARY_DISP" --mode 1366x768 2>/dev/null || \
        xrandr --output "$PRIMARY_DISP" --mode 1280x800 2>/dev/null || \
        xrandr --output "$PRIMARY_DISP" --mode 1280x720 2>/dev/null || true
    fi
fi

# 3. Set clean solid dark background color
if command -v xsetroot >/dev/null 2>&1; then
    xsetroot -solid "#1e1e1e"
fi

# 4. Start SPICE agent for seamless mouse cursor & clipboard synchronization
if command -v spice-vdagent >/dev/null 2>&1; then
    spice-vdagent &
fi

# 5. Launch default terminal on desktop start (spacious 100x30 window)
xterm -geometry 100x30+60+60 -bg black -fg white &

# 6. Launch Fluxbox window manager as master X11 process
exec fluxbox
